# Required for BackSearch requests. Create this in your OpenReward account.
OPENREWARD_API_KEY=or_replace_me

# Required only for examples/research-agent.ts.
OPENAI_API_KEY=sk-replace_me

# Optional. Defaults to the current recommended flagship model.
OPENAI_MODEL=gpt-5.6-sol

# The portal is local-only by default.
HOST=127.0.0.1
PORT=4317

# Strongly recommended if you intentionally expose the portal beyond localhost.
# This is a portal access token, not either provider API key.
BACKSEARCH_ACCESS_TOKEN=
BACKSEARCH_ALLOWED_ORIGIN=
